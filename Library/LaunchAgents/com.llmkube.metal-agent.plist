<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llmkube.metal-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/llmkube-metal-agent</string>
        <string>--namespace</string>
        <string>generic-aiinference-llmkube</string>
        <string>--llama-server</string>
        <string>/opt/homebrew/bin/llama-server</string>
        <string>--port</string>
        <string>9090</string>
        <string>--log-level</string>
        <string>info</string>
        <!-- k8s server to receive llmkube inference requests from -->
        <!-- config-llmkube-metal-agent.yaml generated with: bash k8s.git/cluster/kubernetes/apps/base/generic-aiinference-llmkube/llmkube-kubeconfig-upsert.sh -->
        <string>--kubeconfig</string>
        <string>/Users/davidandreoletti/.kube/config-llmkube-metal-agent.yaml</string>
        <string>--kube-context</string>
        <string>llmkube</string>
        <!-- src: https://github.com/defilantech/LLMKube/blob/53e5090f6a097c380f6106e469ea740041ec66e7/deployment/macos/README.md?plain=1#L1 -->
        <!-- macOS laptop IP the llmkube server (on k8s) can dispatch inference request to -->
        <string>--host-ip</string>
        <string>192.168.3.217</string>
        <!-- Run inference anyway -->
        <string>--memory-check-mode</string>
        <string>warn</string>
        <!--
            0: auto detect based on total RAM
            With 48 GB of total RAM => 75% is 36GB memory budget
        -->
        <string>--memory-fraction</string>
        <string>0</string>
        <string>--memory-pressure-critical</string>
        <string>0.15</string>
        <string>--memory-pressure-warning</string>
        <string>0.20</string>
        <!-- Model store -->
        <string>--model-store</string>
        <string>/Users/davidandreoletti/Documents/Developments/DOTFILES_WORKPACE/dotfiles/.config/llmkube/metal-agent/models</string>
        <!-- Model allowed roots -->
        <string>--allowed-model-roots</string>
        <string>/Users/davidandreoletti/Documents/Developments/DOTFILES_WORKPACE/dotfiles/.config/llmkube/metal-agent/models</string>
        <!-- Model max download size: unlimited -->
        <string>-max-download-size</string>
        <string>0</string>
        <!-- Fallback inference engine -->
        <string>--runtime</string>
        <string>omlx</string>
        <!-- Non random llama server port -->
        <string>--llama-server-port</string>
        <string>7799</string>
        <!-- Longer llama server startup timeout -->
        <string>--llama-server-startup-timeout</string>
        <string>3m0s</string>
        <!-- omlx binary path -->
        <string>-omlx-bin</string>
        <string>/opt/homebrew/bin/omlx</string>
        <!-- Non random omlx server port -->
        <string>--omlx-port</string>
        <string>8929</string>
        <!-- Longer omlx server startup timeout -->
        <string>--omlx-startup-timeout</string>
        <string>3m0s</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- The log paths and WorkingDirectory start with a home placeholder
         that `make install-metal-agent` replaces with $HOME (launchd does not
         expand ~ or $HOME). The model store defaults to
         ~/Library/Application Support/llmkube/models. -->
    <key>StandardOutPath</key>
    <string>/Users/davidandreoletti/Library/Logs/llmkube/metal-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/davidandreoletti/Library/Logs/llmkube/metal-agent.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>GGML_METAL_ENABLE</key>
        <string>1</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/davidandreoletti</string>

    <!-- Restart on failure with throttle -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Nice level (lower = higher priority) -->
    <key>Nice</key>
    <integer>-5</integer>
</dict>
</plist>
